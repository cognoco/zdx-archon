# Archon ~/.archon/.env — template seeded by zdx/archon/deploy.sh on first install.
# Fill in real values before running any workflow. NEVER commit the populated copy.

# ---------------------------------------------------------------------------
# AI Assistants
# ---------------------------------------------------------------------------
CLAUDE_USE_GLOBAL_AUTH=true
CLAUDE_BIN_PATH=/opt/homebrew/bin/claude
DEFAULT_AI_ASSISTANT=claude

# ---------------------------------------------------------------------------
# Codex Authentication — DELIBERATELY DISABLED
#
# Setting CODEX_ID_TOKEN / CODEX_ACCESS_TOKEN / CODEX_REFRESH_TOKEN /
# CODEX_ACCOUNT_ID makes Archon inject them into the codex subprocess env.
# Codex then crashes with: "agent identity JWT payload is not valid JSON".
# Leave these commented; codex picks up its own auth from ~/.codex/ instead.
# ---------------------------------------------------------------------------
# CODEX_ID_TOKEN=
# CODEX_ACCESS_TOKEN=
# CODEX_REFRESH_TOKEN=
# CODEX_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Pi / Provider Keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
# Used by ~/.pi/agent/models.json opencode-go custom provider (apiKey field
# references this env var by name, not value).
OPENCODE_GO_API_KEY=

# ---------------------------------------------------------------------------
# GitHub
# ---------------------------------------------------------------------------
GH_TOKEN=
GITHUB_TOKEN=
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Telegram (optional — only if the host runs the Telegram channel)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_STREAMING_MODE=stream

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT=3090
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Concurrency
# ---------------------------------------------------------------------------
MAX_CONCURRENT_CONVERSATIONS=10

# ---------------------------------------------------------------------------
# Notion / other integrations (fill in if used)
# ---------------------------------------------------------------------------
NOTION_TOKEN=
DOPPLER_TOKEN=

# ---------------------------------------------------------------------------
# Database — force SQLite by leaving empty (loaded with override:true).
# Set to postgresql://... to use Postgres instead.
# ---------------------------------------------------------------------------
DATABASE_URL=
